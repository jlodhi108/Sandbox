# Uses a local Ollama model by default — no API key needed.
# Run `ollama serve` and `ollama pull qwen2.5-coder:14b` before running main.py.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Optional — only needed if [observability].tracing is enabled in
# .modernizer.toml. Get a free key at smith.langchain.com.
LANGSMITH_API_KEY=
