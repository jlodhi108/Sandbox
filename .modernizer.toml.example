# Copy to .modernizer.toml and edit. Every setting here is optional —
# omit anything you want to leave at its default, or override via CLI
# flag / env var (those always win over this file).
#
# Do NOT put GITHUB_TOKEN, LANGSMITH_API_KEY, or any other secret in
# this file — it's meant to be committed alongside the code it
# configures. Secrets stay in .env or the shell environment.

[settings]
max_iterations = 5
workers = 1
#
# Requires workers > 1 and the target to be a git repository. Each
# concurrent worker reads/writes inside its own `git worktree` checkout
# instead of the shared directory directly — see --isolate-workers'
# --help text and git_ops/worktree.py's module docstring for exactly
# what this does and doesn't protect against. Off by default: a
# worktree checkout per file isn't free, and nothing in the pipeline
# actually races without it today.
# isolate_workers = true
#
# Seconds between change-detection polls in --watch mode.
# watch_interval_seconds = 5
#
# Shortcut for --recipe NAME — selects a [recipes.NAME] table defined
# further down this file (see the [recipes.*] section below). Equivalent
# to passing --recipe on the command line every time.
# recipe = "callbacks-to-async"
#
# report = "modernizer-report.json"
#
# Self-contained HTML counterpart to `report` above — per-chunk status,
# flags (risk/security/low-confidence), iteration count, and diffs,
# viewable in a browser instead of reading raw JSON. Independent of
# `report`; set both to get both.
# report_html = "modernizer-report.html"
#
# SARIF 2.1.0 output for accumulated static-security-scan findings (see
# sandbox/security-rules.yaml) — the standard format GitHub Code Scanning
# / Advanced Security (and most other CI security dashboards) ingest
# directly. Independent of `report`/`report_html`; set any combination.
# sarif_report = "modernizer-report.sarif"
#
# Hard ceiling on total LLM calls for ONE run (a single file, or a whole
# repo run) — unset means unlimited. best-of-N x retry-iterations x
# probes x chunks x files can multiply fast with nothing capping it
# otherwise; once hit, remaining chunks/files are cleanly skipped
# (marked budget_exceeded in --report output) rather than the run
# crashing or silently continuing forever. Actual usage for the run is
# always printed at the end and included in --report's "llm_usage" key,
# whether or not this is set.
# max_llm_calls_per_run = 200
#
# Repo mode only. If the target repo has a recognized test suite
# (pytest, npm test, PHPUnit, Maven/Gradle), run it before AND after
# modernization to catch regressions an independent, human-authored
# oracle would catch — see target_tests.py's module docstring for why
# this runs on the HOST (not the sandbox) and only ever touches a
# TEMPORARY COPY of the repo, never your real working tree. A regression
# refuses --pr for that run. Off by default — this is a materially
# different trust boundary from everything else in this project (real
# subprocess execution of the target repo's own test command, not a
# sandboxed container), so it's opt-in even though it never touches your
# actual files.
# run_target_tests = true
#
# For each successfully modernized chunk, write its captured
# verification probes into a standalone, durable test file next to the
# output (e.g. calc.py -> test_calc_modernized.py) — turning this run's
# verification into lasting test coverage that needs neither this
# project nor an LLM to re-check later. Always a NEW sibling file, never
# overwrites anything. Supported for python/javascript/typescript/php
# (the languages that generate probes at all — see
# regression_tests.py); a no-op for cpp/java. Off by default simply to
# avoid writing files the user didn't ask for on every run.
# generate_regression_tests = true
#
# For EVERY chunk this run looks at — successful AND gave-up — write its
# captured verification probes into a standalone "characterization test"
# file that embeds the ORIGINAL (pre-modernization) code, not the
# modernized version (e.g. calc.py -> test_calc_characterization.py).
# Pins down what the legacy code actually does today, quirks and bugs
# included, as a permanent safety net — matters MOST for chunks this
# project couldn't successfully modernize, since --generate-regression-
# tests above only ever covers successful ones. Independent of
# --generate-regression-tests; enable both to get both. Chunks skipped
# by punt_check capture no probe data and are never characterized.
# Supported for python/javascript/typescript/php; a no-op for cpp/java.
# characterize = true
#
# Pause on any chunk flagged (risk, security, or low-confidence mutation
# check) and prompt right here in the terminal to approve or reject it,
# instead of just flagging and continuing — see agents/review_graph.py.
# Uses LangGraph's native interrupt()/Command mechanism: the graph
# genuinely pauses (checkpointed in memory) and resumes from that exact
# point once you answer, rather than this being a bolted-on prompt
# outside the graph. Not supported together with workers > 1 (concurrent
# prompts would garble the terminal) — CLI refuses that combination.
# interactive = true
#
# Before attempting each chunk, ask the model to self-assess whether
# it's confident it can modernize THIS specific chunk correctly. If not,
# the chunk is skipped before any rewrite attempt (no best-of-N
# generation, no sandbox verification) — costs one extra LLM call per
# chunk to potentially save a much larger one on chunks the model
# already doubts. Punted chunks are excluded from track_record.py's
# success-rate calculation (see main.py's chunks_punted stat) — a chunk
# never attempted isn't a failed attempt. Off by default: it's a genuine
# tradeoff (an extra LLM call per chunk, and a false-positive punt means
# a chunk that would have succeeded gets skipped instead), not a strict
# improvement for every workload.
# punt_check = true

[model]
# The workhorse model every chunk is first attempted with. Must already
# be pulled locally (`ollama pull <name>`). Defaults to qwen2.5-coder:14b
# if unset.
# base_model = "qwen2.5-coder:14b"

[escalation]
# model = "qwen2.5-coder:32b"
# threshold = 3
#
# Model used to critique a chunk's risk level (assess_risk) instead of
# whichever model actually wrote it — a model reviewing its own output
# is a measurably weak checker, independent of how capable it is (see
# agents/nodes.py's _select_reviewer_llm for the full fallback chain).
# Optional: if `model` above is set and this isn't, the escalation
# model and base model already review each other for free with zero
# extra config. Set this only if you want a SPECIFIC reviewer regardless
# of escalation state.
# reviewer_model = "qwen2.5-coder:1.5b"

[github]
# repo = "owner/repo"

[autonomy]
# Gates automatic PR creation (--pr) on a language's PROVEN track record
# in THIS project, tracked in .modernizer_history.json across every past
# run. A language with no history — or a poor one — cannot auto-open a
# PR no matter how clean the current run looks; it must first accumulate
# enough successful chunks the manual-review way. Lower these to build
# trust faster (or effectively disable the gate with min_track_record_chunks
# = 0), raise them to require a stronger track record before ever trusting
# --pr unattended.
# min_track_record_chunks = 5
# min_success_rate = 0.8

[sandbox]
# Every container (execution sandbox AND the semgrep scan) already runs
# with resource caps + non-root user + no network + a HARDENED seccomp
# profile (sandbox/seccomp-profile.json, on by default — no config
# needed, works identically on Linux and macOS Docker Desktop; set
# DISABLE_SECCOMP_PROFILE=1 as an env var if some future toolchain
# genuinely needs a syscall it blocks). The setting below is for going
# further still, specifically for the container that EXECUTES modernized
# code:
#
# Stronger container isolation for the sandbox that EXECUTES modernized
# code (not the semgrep security scan, which never executes anything).
# "runsc" = gVisor: a user-space kernel that intercepts syscalls instead
# of letting them reach the host kernel directly, drastically shrinking
# the attack surface an escape would need. This is a step beyond the
# seccomp hardening above, not a replacement for it — real additional
# isolation, but with real host-setup cost (see below), unlike the
# seccomp profile.
#
# This is a HOST-level, Linux-only setup step this project cannot
# provide for you: install gVisor (https://gvisor.dev/docs/user_guide/install/)
# and register it with the Docker daemon (add to
# /etc/docker/daemon.json: {"runtimes": {"runsc": {"path": "/usr/local/bin/runsc"}}},
# then restart Docker) BEFORE setting this — an unregistered runtime name
# makes every sandbox call fail immediately with a clear Docker error.
# Works on native Linux Docker (a CI runner, an EC2 box). Docker
# Desktop's managed VM (macOS/Windows) has no supported way to add a
# runtime to it at all, so this option is a no-op there regardless.
# runtime = "runsc"

[context]
# Optional local embedding model (pulled via `ollama pull nomic-embed-text`
# exactly like any other model this project uses) for RANKING sibling
# files by actual semantic relevance when building the cross-file
# grounding context (see agents/graph.py's _extract_context_signatures /
# _extract_referenced_type_definitions) — without this, the existing
# capped scan just takes the first N sibling files in discovery order,
# which in a large repo often aren't the most relevant N. Off by
# default: the existing scan already works, this just makes it more
# precise at repo scale, and it costs an extra Ollama embedding call per
# sibling file per run (cached within a run, but not free). Good
# defaults if you want to try it: "nomic-embed-text" (small, fast,
# CPU-friendly) or "qwen3-embedding" (higher quality, more VRAM).
# embedding_model = "nomic-embed-text"
#
# Setting embedding_model ALSO enables the few-shot exemplar bank (see
# exemplar_bank.py): every CLEAN successful modernization (no risk/
# security/low-confidence flag) gets remembered locally
# (.modernizer_history.json's sibling, .modernizer_exemplars.json —
# gitignored, per-machine state), and the most similar past success is
# shown as a worked "before/after" example on each chunk's first
# attempt. No separate setting — it's the same embedding_model gate,
# since showing an unranked example would do more harm than good.

# Named settings bundles, selected via --profile NAME (or the [settings]
# `profile` key above to make one the default for every run). Two
# built-in profiles always exist even without any [profiles.*] table
# here: "safe" (max_iterations=8, punt_check/characterize/
# generate_regression_tests all true — favors thoroughness) and "fast"
# (max_iterations=2, those three off — favors turnaround). A
# [profiles.NAME] table here with the SAME name as a built-in overrides
# just the fields you set, leaving the rest of that built-in's defaults
# in place; a new NAME defines a wholly custom profile. Any individual
# CLI flag still overrides whatever the active profile sets.
#
# [profiles.safe]
# max_iterations = 12  # override just this one field of the built-in "safe"
#
# [profiles.thorough]
# max_iterations = 10
# punt_check = true
# characterize = true
# generate_regression_tests = true
# run_target_tests = true

[observability]
# Per-chunk LLM tracing via LangSmith (smith.langchain.com) — token
# counts, latency, and the full prompt/response for every refactor,
# risk-assessment, and probe-generation call, viewable per run. This
# project already runs on LangGraph/LangChain, so enabling this needs
# no code changes: LangChain's chat model classes check these exact
# environment variables on every call. Requires a (free-tier available)
# LangSmith account and API key — the key goes in .env as
# LANGSMITH_API_KEY, never in this file.
# tracing = true
# project = "code-modernizer"
# endpoint = "https://api.smith.langchain.com"  # only for self-hosted LangSmith

# Named modernization recipes, selected via --recipe NAME. Each table's
# `instruction` is appended to the base per-language system prompt for
# EVERY chunk in the run — use it to scope WHAT KIND of modernization
# happens, not just "make it modern" in general. Without --recipe, none
# of this applies and behavior is unchanged. Define as many as you like;
# these three are examples, not defaults.
#
# [recipes.callbacks-to-async]
# instruction = """
# Only modernize functions that use callback-style asynchronous patterns
# (a function taking a callback parameter, or Node-style
# error-first callbacks). Convert them to async/await. Leave every other
# function completely untouched, even if it has other legacy patterns —
# do not modernize unrelated things in the same run.
# """
#
# [recipes.py2-to-py3]
# instruction = """
# Focus specifically on Python 2 -> 3 incompatibilities: print statements
# to print(), unicode/str handling, integer division, dict .iteritems()/
# .has_key(), and similar. Don't make unrelated style changes.
# """
#
# [recipes.jquery-to-vanilla]
# instruction = """
# Replace jQuery API usage ($(...), .ajax, .on, .css, etc.) with
# equivalent vanilla DOM APIs (querySelector, fetch, addEventListener,
# style property access). Leave non-jQuery-related code as-is.
# """
